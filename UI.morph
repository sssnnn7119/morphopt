  },
  "custom_classes": [],
  "class_bindings": {},
  "helper_code": "import torch\nimport math\n",
  "helper_variables": [],
  "helper_functions": [
    {
      "kind": "helper_function",
      "name": "reference_point_motion",
      "params": {
        "parameters": "objective: morphopt.ObjectiveFunction, case_name: str",
        "body": "objective.set_step(case_name)\nassembly = objective.fe.assembly\ncoordinates = objective.fe_results[case_name].GC.to(assembly.device)\nreference_point = assembly.get_reference_point(\"RP_head\")\nreturn assembly._GC2RGC(coordinates)[reference_point._RGC_index].reshape(-1)"
      },
      "children": []
    },
    {
      "kind": "helper_function",
      "name": "rotate_about_z",
      "params": {
        "parameters": "points: torch.Tensor, angle: float",
        "body": "cosine, sine = math.cos(angle), math.sin(angle)\nreturn torch.stack([\n    cosine * points[..., 0] - sine * points[..., 1],\n    sine * points[..., 0] + cosine * points[..., 1],\n    points[..., 2],\n], dim=-1)"
      },
      "children": []
    }
  ]
}