      {
        "kind": "objective",
        "name": "Objective Function",
        "params": {
          "objective_terms": [
            {
              "type": "custom_loss",
              "weight": 1.0,
              "body": "uz_compression = reference_point_motion(self, \"compression\")[2]\nuz_extension = reference_point_motion(self, \"extension\")[2]\nreturn torch.exp(1.0 - (uz_extension - uz_compression) / 24.0)"
            },
            {
              "type": "custom_loss",
              "weight": 1.0,
              "body": "ry = reference_point_motion(self, \"bending\")[4]\nreturn torch.exp(1.0 - ry / 2.1)"
            },
            {
              "type": "custom_loss",
              "weight": 1.0,
              "body": "motion = reference_point_motion(self, \"bending\")\nreturn (motion[2] + 70.0) / torch.sin(motion[4])"
            },
            {
              "type": "custom_loss",
              "weight": 1.0,
              "body": "return reference_point_motion(self, \"gravity\")[1]"
            }
          ],
          "metrics_terms": [
            {
              "type": "custom",
              "body": "return reference_point_motion(self, \"extension\")[2] - reference_point_motion(self, \"compression\")[2]"
            },
            {
              "type": "displacement",
              "reference_point_name": "RP_head",
              "step_name": "bending",
              "component": "ry"
            },
            {
              "type": "custom",
              "body": "return reference_point_motion(self, \"bending\")[2] + 70.0"
            },
            {
              "type": "custom",
              "body": "motion = reference_point_motion(self, \"bending\")\nreturn (motion[2] + 70.0) / torch.sin(motion[4])"
            },
            {
              "type": "displacement",
              "reference_point_name": "RP_head",
              "step_name": "gravity",
              "component": "uy"
            }
