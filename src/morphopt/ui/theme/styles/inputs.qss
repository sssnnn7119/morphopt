/* Editable fields, selection controls, and split-panel separators. */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: @input@;
    color: @text@;
    border: 1px solid @border@;
    padding: 3px;
}
QComboBox { combobox-popup: 0; qproperty-maxVisibleItems: 12; }
QComboBox QAbstractItemView {
    background: @panel@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @selection@;
}
QCheckBox { color: @text@; }
QScrollBar:vertical, QScrollBar:horizontal { background: @panel@; }
QScrollBar:vertical { width: 12px; }
QScrollBar:horizontal { height: 12px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: @muted_text@;
    border-radius: 5px;
}
QScrollBar::handle:vertical { min-height: 28px; }
QScrollBar::handle:horizontal { min-width: 28px; }
QScrollBar::handle:hover { background: @accent_hover@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: @border@; }
