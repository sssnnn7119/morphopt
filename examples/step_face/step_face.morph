  "helper_code": "import torch\n",
  "helper_variables": [
    {
      "kind": "helper_variable",
      "name": "design_length",
      "params": {
        "value": "16.0"
      },
      "children": []
    }
  ],
  "helper_functions": [
    {
      "kind": "helper_function",
      "name": "tip_motion",
      "params": {
        "parameters": "objective, step",
        "body": "objective.set_step(step)\nassembly = objective.fe.assembly\nstate = assembly._GC2RGC(objective.fe_results[step].GC.to(assembly.device))\nreturn state[assembly.get_reference_point(\"RP_tip\")._RGC_index].reshape(-1)\n"
      },
      "children": []
    }
  ]
