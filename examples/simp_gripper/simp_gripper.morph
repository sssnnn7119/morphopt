  "custom_classes": [
    {
      "kind": "custom_class",
      "name": "GripperPartBuilder",
      "params": {
        "base_class": "morphopt.BasePart",
        "class_type": "override"
      },
      "children": [
        {
          "kind": "method_override",
          "name": "build_part",
          "params": {
            "body": "return _build_gripper_part(self.part_name)"
          },
          "children": []
        }
      ]
    },
    {
      "kind": "custom_class",
      "name": "CylinderPartBuilder",
      "params": {
        "base_class": "morphopt.BasePart",
        "class_type": "override"
      },
      "children": [
        {
          "kind": "method_override",
          "name": "build_part",
          "params": {
            "body": "return _build_cylinder_part(self.part_name)"
          },
          "children": []
        }
      ]
    },
    {
      "kind": "custom_class",
      "name": "GripperObjective",
      "params": {
        "base_class": "morphopt.ObjectiveFunction",
        "class_type": "override"
      },
      "children": [
        {
          "kind": "method_override",
          "name": "objective_function",
          "params": {
            "body": "loss_list = []\nfor stepidx in range(self.num_tasks):\n    step = f\"load_case_{stepidx + 1}\"\n    self.set_step(step)\n    total_force = self.fe.assembly._assemble_generalized_Matrix(GC=self.fe_results[step].GC)[0]\n    instance = self.fe.assembly.get_instance(\"final_model\")\n    starts = self.fe.assembly._RGC_list_indexStart\n    force = total_force[starts[instance._RGC_index]:starts[instance._RGC_index + 1]].reshape([-1, 3])\n    loss_list.append(torch.exp(force[:, 0].sum()) - force[:, 2].sum())\nreturn torch.stack(loss_list).sum()"
          },
          "children": []
        },
        {
          "kind": "method_override",
          "name": "get_metrics",
          "params": {
            "body": "metrics = []\nfor stepidx in range(self.num_tasks):\n    step = f\"load_case_{stepidx + 1}\"\n    self.set_step(step)\n    total_force = self.fe.assembly._assemble_generalized_Matrix(GC=self.fe_results[step].GC)[0]\n    instance = self.fe.assembly.get_instance(\"final_model\")\n    starts = self.fe.assembly._RGC_list_indexStart\n    force = total_force[starts[instance._RGC_index]:starts[instance._RGC_index + 1]].reshape([-1, 3])\n    metrics.extend([force[:, 0].sum(), force[:, 2].sum()])\nreturn metrics + [_get_volume_fraction(self)]"
          },
          "children": []
        }
      ]
    },
    {
      "kind": "custom_class",
      "name": "GripperMaterial",
      "params": {
        "base_class": "morphopt.SIMP_BSPFieldMaterials",
        "class_type": "override"
      },
      "children": [
        {
          "kind": "method_override",
          "name": "reinitialize",
          "params": {
            "body": "control_points = self._cps.reshape(self._bsp_size[0], self._bsp_size[1], self._bsp_size[2]).clone()\ncontrol_points[:, :, -2:] = 15.0\nself._cps = control_points.reshape_as(self._cps)\nreturn super().reinitialize(iteration, *args, **kwargs)"
          },
          "children": []
        }
      ]
    }
  ],
  "class_bindings": {
    "ThisController.ObjectiveFunction": "GripperObjective"
  },
  "helper_code": "import numpy as np\nimport torch\nimport torchfea\n\nmumax = 10.0\nminratio = 1e-7\ncylinder_x = [80.0, 70.0, 60.0, 50.0]\n\ndef _surface_at_coordinate(part, element_name, axis, coordinate, tolerance=1e-8):\n    element = part.elems[element_name]\n    selected = []\n    for element_ids, side in element.extract_boundary_surface_set():\n        ids = np.asarray(element_ids, dtype=np.int64)\n        index = torch.as_tensor(ids, dtype=torch.long, device=element._elems.device)\n        face_nodes = element._elems[index][:, element.surfaceid_map[int(side)]]\n        on_plane = (part.nodes[face_nodes][..., axis] - float(coordinate)).abs().amax(dim=1)\n        matching = ids[(on_plane <= tolerance).detach().cpu().numpy()]\n        if len(matching):\n            selected.append((matching, int(side)))\n    if not selected:\n        raise RuntimeError(f\"No boundary faces found on axis {axis}={coordinate}.\")\n    return selected\n\ndef _get_volume_fraction(objective):\n    elems = objective.fe.assembly._parts[\"final_model\"].elems[\"C3D4\"]\n    ratio = elems.materials[\"material-0\"].scale\n    weights = elems.gaussian_weight\n    return (weights * ratio).sum() / weights.sum()\n\ndef _add_gripper_sets(part):\n    element_name = \"C3D4\"\n    xmin_nodes = torch.where((part.nodes[:, 0] - 0.0).abs() <= 1e-8)[0]\n    if not xmin_nodes.numel():\n        raise RuntimeError(\"No gripper nodes found on x=0.\")\n    part.add_node_set(\"nodes_xmin\", xmin_nodes)\n    part.add_surface_set(\"surface_zmax\", _surface_at_coordinate(part, element_name, 2, 0.0))\n    part.add_surface_set(\"surface_0_All\", list(part.surfaces[\"extern\"]))\n    part.exterior_surface = \"surface_0_All\"\n\ndef _build_gripper_part(part_name):\n    cad = torchfea.cad.CADModel()\n    history = cad.add_part(part_name)\n    history.add_box(x=0.0, y=-0.5, z=-30.0, dx=80.0, dy=1.0, dz=30.0)\n    part = cad.mesh_part(part_name, mesh_size=0.5)\n    _add_gripper_sets(part)\n    return part\n\ndef _build_cylinder_part(part_name):\n    cad = torchfea.cad.CADModel()\n    history = cad.add_part(part_name)\n    history.add_cylinder(x=80.0, y=-10.0, z=15.0, dy=20.0, radius=15.0)\n    part = cad.mesh_part(part_name, mesh_size=1.5)\n    part.add_node_set(\"cylinder\", part.set_nodes[\"all\"])\n    return part\n",
  "helper_variables": [],
  "helper_functions": []
}
